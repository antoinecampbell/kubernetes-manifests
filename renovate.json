{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": ["kubernetes", "helmv3", "kustomize"],
  "prCreation": "immediate",
  "packageRules": [
    {
      "matchDatasources": ["helm", "docker"],
      "pinDigests": false
    },
    {
      "matchDatasources": ["helm", "docker"],
      "matchPackageNames": [
        "alloy",
        "argo-cd",
        "camunda-platform",
        "cloudflare/cloudflared",
        "ghcr.io/grafana-community/helm-charts/loki",
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
        "registry-1.docker.io/bitnamicharts/postgresql",
        "registry-1.docker.io/bitnamicharts/redis",
        "renovate/renovate"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "14 days",
      "ignoreTests": true,
      "labels": ["auto merge"]
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  }
}
