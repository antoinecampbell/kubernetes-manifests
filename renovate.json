{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "enabledManagers": ["kubernetes", "helmv3", "kustomize"],
  "prCreation": "immediate",
  "packageRules": [
    {
      "matchDatasources": ["helm", "docker"],
      "pinDigests": false
    },
    {
      "matchDatasources": ["helm", "docker"],
      "matchPackageNames": [
        "postgresql",
        "bitnami/postgresql",
        "redis",
        "bitnami/redis",
        "camunda-platform",
        "camunda/camunda-platform"
      ],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "14 days",
      "ignoreTests": true,
      "labels": ["auto merge"]
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/"
    ]
  }
}
